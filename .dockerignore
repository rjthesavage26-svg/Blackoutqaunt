# Git and local editor state
.git
.gitignore
.DS_Store
.idea/
.vscode/

# Secrets and local environment
.env
.env.*
!.env.example
!.env.*.example

# Python generated/runtime files
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node generated/runtime files
node_modules/
frontend/node_modules/
frontend/dist/

# SQLite runtime databases and backups
backend/data/*.db
backend/data/*.db-*
backend/**/data/*.db
backend/**/data/*.db-*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
