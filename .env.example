APP_NAME=Blackout Quant
APP_ENV=development
DATABASE_URL=sqlite:///backend/data/blackout_quant.db
BACKEND_CORS_ORIGINS=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:8000
TRADINGVIEW_ENABLED=false
TRADINGVIEW_WEBHOOK_PATH=/webhook/tradingview
LOG_LEVEL=INFO
# Optional shared secret. If set, send it in the X-Blackout-Secret header.
WEBHOOK_SECRET=
PAPER_STARTING_CASH=100000
PAPER_POSITION_NOTIONAL=10000
PAPER_SLIPPAGE_BPS=0
PAPER_COMMISSION_PER_ORDER=0
ANALYSIS_WORKER_MAX_ATTEMPTS=3
EXECUTION_MODE=internal_paper
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_API_KEY=
ALPACA_API_SECRET=
STRATEGY_SYMBOL=QQQ
STRATEGY_POLL_SECONDS=30
